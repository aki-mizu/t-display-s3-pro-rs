import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Toggle, NavButton } from "common.slint";

// Compact landscape UI for the board's 480×222 logical viewport.
export component AppWindow inherits Window {
    in-out property <int> battery-percentage: 0;
    in-out property <bool> charging: true;
    in-out property <string> pmu-details: "No data yet\n\nPress refresh in PMU Details screen";
    in-out property <string> camera-status: "Camera Shield status is not available yet";
    in-out property <int> current-screen: 0; // 0: battery, 1: PMU, 2: camera status

    callback toggle-charger(bool);
    callback request-pmu-update();

    width: 480px;
    height: 222px;
    background: white;

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            width: 78px;
            background: #F5F5F5;
            border-color: #E0E0E0;
            border-width: 1px;

            VerticalLayout {
                padding: 4px;
                spacing: 5px;
                alignment: start;

                NavButton {
                    label: "Main";
                    active: root.current-screen == 0;
                    height: 38px;
                    clicked => { root.current-screen = 0; }
                }
                NavButton {
                    label: "PMU";
                    active: root.current-screen == 1;
                    height: 38px;
                    clicked => { root.current-screen = 1; }
                }
                NavButton {
                    label: "Cam";
                    active: root.current-screen == 2;
                    height: 38px;
                    clicked => { root.current-screen = 2; }
                }
            }
        }

        Rectangle {
            width: parent.width - 78px;
            background: white;

            if root.current-screen == 0: HorizontalLayout {
                padding: 10px;
                spacing: 10px;

                VerticalLayout {
                    width: 58%;
                    spacing: 3px;
                    alignment: center;

                    Text {
                        text: root.battery-percentage + "%";
                        font-size: 60px;
                        font-weight: 900;
                        color: root.battery-percentage < 20 ? #F44336 : (root.battery-percentage < 50 ? #FF9800 : #4CAF50);
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Battery";
                        font-size: 18px;
                        color: #666666;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    width: 42%;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "Charger";
                        font-size: 18px;
                        color: #201f1e;
                        horizontal-alignment: center;
                    }
                    Toggle {
                        on: root.charging;
                        clicked => { root.toggle-charger(!self.on); }
                    }
                }
            }

            if root.current-screen == 1: Rectangle {
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;

                    Flickable {
                        height: parent.height;
                        interactive: true;
                        viewport-height: pmu-text.preferred-height;

                        pmu-text := Text {
                            text: root.pmu-details;
                            font-size: 14px;
                            width: parent.viewport-width;
                            wrap: word-wrap;
                            color: #201f1e;
                        }
                    }
                }

                Rectangle {
                    width: 82px;
                    height: 34px;
                    x: parent.width - self.width - 8px;
                    y: parent.height - self.height - 8px;
                    background: #2196F3;
                    border-radius: 17px;

                    Text {
                        text: "Refresh";
                        font-size: 14px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.request-pmu-update(); } }
                }
            }

            if root.current-screen == 2: VerticalLayout {
                padding: 10px;
                spacing: 4px;

                Text {
                    text: "Camera Shield";
                    font-size: 22px;
                    font-weight: 700;
                    color: #201f1e;
                }
                Flickable {
                    height: parent.height;
                    interactive: true;
                    viewport-height: camera-text.preferred-height;

                    camera-text := Text {
                        text: root.camera-status;
                        font-size: 14px;
                        width: parent.viewport-width;
                        wrap: word-wrap;
                        color: #201f1e;
                    }
                }
            }
        }
    }
}
