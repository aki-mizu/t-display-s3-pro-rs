export global BitcoinPalette {
    out property <color> page: #101827;
    out property <color> panel: #192235;
    out property <color> panel-highlight: #243149;
    out property <color> border: #34435c;
    out property <color> text: #f8fafc;
    out property <color> muted: #9aa8bd;
    out property <color> accent: #f7931a;
}

export component KeyButton inherits Rectangle {
    in-out property <string> label: "";
    in-out property <bool> active: false;
    callback clicked();

    height: 28px;
    border-radius: 5px;
    border-width: 1px;
    border-color: active ? BitcoinPalette.accent : BitcoinPalette.border;
    background: active ? BitcoinPalette.accent : BitcoinPalette.panel-highlight;

    Text {
        text: root.label;
        color: active ? #211204 : BitcoinPalette.text;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea { clicked => { root.clicked(); } }
}
