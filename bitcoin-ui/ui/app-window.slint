import { BitcoinPalette, KeyButton } from "common.slint";

// Keeps the BIP39 keyboard's high-contrast availability treatment separate
// from generic action buttons such as Reset and Back.
component Bip39LetterKey inherits KeyButton {
    letter-key: true;
}

// A compact, original battery status indicator. Battery percentage stays
// internal so the display remains glanceable.
component BatteryStatusIcon inherits Rectangle {
    in property <bool> usb-present: false;
    in property <bool> battery-present: false;
    in property <int> battery-percentage: 0;
    // `battery-charging` represents the active pre/fast-charge phase, while
    // `charge-complete` selects the static-full presentation.
    in property <bool> battery-charging: false;
    in property <bool> charge-complete: false;

    property <bool> icon-visible: root.battery-present;
    // Keep the external-power presentation stable even if the PMU briefly
    // changes between charging sub-phases while a cable remains connected.
    property <bool> external-power: root.icon-visible && root.usb-present;
    property <bool> active-charge: root.external-power && root.battery-charging;
    property <bool> complete-charge: root.external-power && root.charge-complete;
    // Battery-only colors and bands mirror Jade: empty is red, its lowest
    // non-empty band is orange, and all higher bands are white. USB power
    // remains orange so active and completed charging stay easy to identify.
    property <color> battery-color: root.external-power ? BitcoinPalette.accent : root.battery-percentage == 0 ? #ef4444 : root.battery-percentage <= 20 ? BitcoinPalette.accent : BitcoinPalette.text;
    property <length> battery-fill-width: root.battery-percentage == 0 ? 0px : root.battery-percentage <= 20 ? 4px : root.battery-percentage <= 40 ? 7px : root.battery-percentage <= 60 ? 10px : root.battery-percentage <= 80 ? 13px : 17px;
    // Repeat the familiar 20 → 50 → 80 → 100% charging sequence once every
    // two seconds. A discrete timer redraws only four times per cycle;
    // `animation-tick()` would otherwise keep the full display rendering at
    // the touch-poll cadence even though the visible fill has not changed.
    property <int> charging-phase: 0;
    Timer {
        running: root.active-charge;
        interval: 500ms;
        triggered => { root.charging-phase = mod(root.charging-phase + 1, 4); }
    }
    property <length> active-charge-fill-width: root.charging-phase == 0 ? 4px : root.charging-phase == 1 ? 9px : root.charging-phase == 2 ? 14px : 17px;

    width: 24px;
    height: 15px;
    visible: root.icon-visible;

    // Battery-only states follow Jade's red/orange/white bands. Active
    // charging animates orange; a completed charge is static full orange.
    Rectangle {
        x: 0px;
        y: 2px;
        width: 21px;
        height: 11px;
        background: #00000000;
        border-color: root.battery-color;
        border-width: 1px;
        border-radius: 1px;
    }
    Rectangle {
        x: 21px;
        y: 5px;
        width: 2px;
        height: 5px;
        background: root.battery-color;
        border-radius: 1px;
    }
    Rectangle {
        // The animation branch is evaluated only while actively charging.
        x: 2px;
        y: 4px;
        width: root.active-charge ? root.active-charge-fill-width : root.complete-charge ? 17px : root.battery-fill-width;
        height: 7px;
        background: root.battery-color;
        border-radius: 1px;
    }
}

// A local-only BIP39 final-word helper. It never derives keys, signs, or
// persists a mnemonic; the Rust bridge retains only word-list indices.
export component AppWindow inherits Window {
    // Board-supplied power facts, displayed as a compact always-visible
    // top-right indicator without exposing hardware APIs to the UI flow.
    in-out property <bool> usb-present: false;
    in-out property <bool> battery-present: false;
    in-out property <int> battery-percentage: 0;
    // Charge phase bridge: `battery-charging` is active/pre-charge and
    // `charge-complete` selects static-full. Both default to false so
    // older firmware retains the static battery-only indicator.
    in-out property <bool> battery-charging: false;
    in-out property <bool> charge-complete: false;
    in-out property <int> current-screen: 0;
    in-out property <string> mnemonic-prefix: "";
    in-out property <string> mnemonic-entry: "";
    in-out property <string> mnemonic-message: "Enter word 1 of 11.";
    in-out property <string> mnemonic-confirmed-words: "";
    in-out property <int> mnemonic-confirmed-words-font-size-hundredths: 2000;
    in-out property <bool> mnemonic-can-commit: false;
    // One entry per lowercase English letter (a=0 through z=25). Rust
    // refreshes it after every edit so impossible next letters are disabled.
    in-out property <[bool]> mnemonic-next-letters: [];
    in-out property <string> candidate-word: "";
    in-out property <int> candidate-index: 0;
    in-out property <string> entropy-bits-label: "0000000";
    in-out property <bool> entropy-bit-64: false;
    in-out property <bool> entropy-bit-32: false;
    in-out property <bool> entropy-bit-16: false;
    in-out property <bool> entropy-bit-8: false;
    in-out property <bool> entropy-bit-4: false;
    in-out property <bool> entropy-bit-2: false;
    in-out property <bool> entropy-bit-1: false;

    callback mnemonic-key(int);
    callback mnemonic-backspace();
    callback mnemonic-commit();
    callback mnemonic-reset();
    callback request-random-words();
    callback entropy-toggle(int);
    callback entropy-confirm();

    width: 480px;
    height: 222px;
    background: BitcoinPalette.page;

    Rectangle {
        width: 480px;
        height: 222px;
        background: BitcoinPalette.page;

        if root.current-screen == 0: VerticalLayout {
            padding-top: 4px;
            padding-bottom: 2px;
            padding-left: 0px;
            padding-right: 0px;
            // A 48 px square is the largest uniform letter key that fits ten
            // top-row keys across the 480 px display.
            spacing: 0px;

            Rectangle {
                height: root.mnemonic-confirmed-words == "" ? 15px : 36px;
                background: #00000000;

                Text {
                    text: "BIP39 final word";
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    color: BitcoinPalette.text;
                    font-size: 15px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    visible: root.mnemonic-confirmed-words == "";
                }

                Text {
                    text: root.mnemonic-confirmed-words;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    color: BitcoinPalette.text;
                    font-size: root.mnemonic-confirmed-words-font-size-hundredths * 0.01px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: clip;
                    visible: root.mnemonic-confirmed-words != "";
                }
            }

            Text {
                text: root.mnemonic-message;
                color: BitcoinPalette.muted;
                height: root.mnemonic-confirmed-words == "" ? 10px : 0px;
                font-size: 9px;
                horizontal-alignment: center;
                overflow: elide;
                visible: root.mnemonic-message != "";
            }

            Rectangle {
                height: root.mnemonic-confirmed-words == "" ? 47px : 36px;
                background: BitcoinPalette.panel;
                border-color: BitcoinPalette.border;
                border-width: 1px;
                border-radius: 6px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 4px;
                    padding-top: 1px;
                    padding-bottom: 1px;
                    spacing: 3px;

                    Text {
                        width: 70px;
                        text: root.mnemonic-prefix == "" ? "Input: —" : "Input: " + root.mnemonic-prefix;
                        color: BitcoinPalette.accent;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: 211px;
                        text: root.mnemonic-entry;
                        color: BitcoinPalette.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    KeyButton {
                        width: 104px;
                        height: root.mnemonic-confirmed-words == "" ? 45px : 34px;
                        label: "Use word";
                        active: root.mnemonic-can-commit;
                        clicked => { root.mnemonic-commit(); }
                    }
                    KeyButton {
                        width: 70px;
                        height: root.mnemonic-confirmed-words == "" ? 45px : 34px;
                        label: "Reset";
                        clicked => { root.mnemonic-reset(); }
                    }
                }
            }

            HorizontalLayout {
                height: 48px;
                padding-left: 0px;
                padding-right: 0px;
                spacing: 0px;

                Bip39LetterKey { width: 48px; height: 48px; label: "Q"; enabled: root.mnemonic-next-letters[16]; clicked => { root.mnemonic-key(16); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "W"; enabled: root.mnemonic-next-letters[22]; clicked => { root.mnemonic-key(22); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "E"; enabled: root.mnemonic-next-letters[4]; clicked => { root.mnemonic-key(4); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "R"; enabled: root.mnemonic-next-letters[17]; clicked => { root.mnemonic-key(17); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "T"; enabled: root.mnemonic-next-letters[19]; clicked => { root.mnemonic-key(19); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "Y"; enabled: root.mnemonic-next-letters[24]; clicked => { root.mnemonic-key(24); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "U"; enabled: root.mnemonic-next-letters[20]; clicked => { root.mnemonic-key(20); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "I"; enabled: root.mnemonic-next-letters[8]; clicked => { root.mnemonic-key(8); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "O"; enabled: root.mnemonic-next-letters[14]; clicked => { root.mnemonic-key(14); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "P"; enabled: root.mnemonic-next-letters[15]; clicked => { root.mnemonic-key(15); } }
            }

            HorizontalLayout {
                height: 48px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 0px;

                Bip39LetterKey { width: 48px; height: 48px; label: "A"; enabled: root.mnemonic-next-letters[0]; clicked => { root.mnemonic-key(0); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "S"; enabled: root.mnemonic-next-letters[18]; clicked => { root.mnemonic-key(18); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "D"; enabled: root.mnemonic-next-letters[3]; clicked => { root.mnemonic-key(3); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "F"; enabled: root.mnemonic-next-letters[5]; clicked => { root.mnemonic-key(5); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "G"; enabled: root.mnemonic-next-letters[6]; clicked => { root.mnemonic-key(6); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "H"; enabled: root.mnemonic-next-letters[7]; clicked => { root.mnemonic-key(7); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "J"; enabled: root.mnemonic-next-letters[9]; clicked => { root.mnemonic-key(9); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "K"; enabled: root.mnemonic-next-letters[10]; clicked => { root.mnemonic-key(10); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "L"; enabled: root.mnemonic-next-letters[11]; clicked => { root.mnemonic-key(11); } }
            }

            HorizontalLayout {
                height: 48px;
                // Center the seven-letter bottom QWERTY cluster. The two
                // equally sized actions act like keyboard modifiers.
                padding-left: 0px;
                padding-right: 0px;
                spacing: 0px;

                KeyButton {
                    width: 72px;
                    height: 48px;
                    label: "Random 11";
                    clicked => { root.request-random-words(); }
                }
                Bip39LetterKey { width: 48px; height: 48px; label: "Z"; enabled: root.mnemonic-next-letters[25]; clicked => { root.mnemonic-key(25); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "X"; enabled: root.mnemonic-next-letters[23]; clicked => { root.mnemonic-key(23); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "C"; enabled: root.mnemonic-next-letters[2]; clicked => { root.mnemonic-key(2); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "V"; enabled: root.mnemonic-next-letters[21]; clicked => { root.mnemonic-key(21); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "B"; enabled: root.mnemonic-next-letters[1]; clicked => { root.mnemonic-key(1); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "N"; enabled: root.mnemonic-next-letters[13]; clicked => { root.mnemonic-key(13); } }
                Bip39LetterKey { width: 48px; height: 48px; label: "M"; enabled: root.mnemonic-next-letters[12]; clicked => { root.mnemonic-key(12); } }
                KeyButton {
                    width: 72px;
                    height: 48px;
                    label: "Back";
                    clicked => { root.mnemonic-backspace(); }
                }
            }
        }

        if root.current-screen == 1: VerticalLayout {
            padding: 3px;
            spacing: 2px;

            Text {
                text: "Choose the seven entropy bits";
                color: BitcoinPalette.text;
                height: 15px;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: "Eleven words leave 128 valid final-word candidates.";
                color: BitcoinPalette.muted;
                height: 12px;
                font-size: 9px;
                horizontal-alignment: center;
                overflow: elide;
            }

            Rectangle {
                height: 36px;
                background: BitcoinPalette.panel;
                border-color: BitcoinPalette.border;
                border-width: 1px;
                border-radius: 6px;

                VerticalLayout {
                    padding: 3px;
                    spacing: 1px;

                    Text {
                        height: 12px;
                        text: "Selected bits: " + root.entropy-bits-label;
                        color: BitcoinPalette.accent;
                        font-size: 11px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.candidate-word == "" ? "Final word is not revealed." : "Candidate " + (root.candidate-index + 1) + " of 128: " + root.candidate-word;
                        color: BitcoinPalette.text;
                        font-size: 12px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                height: 46px;
                padding-left: 1px;
                padding-right: 1px;
                spacing: 0px;

                KeyButton { width: 118px; height: 46px; label: "64"; active: root.entropy-bit-64; clicked => { root.entropy-toggle(6); } }
                KeyButton { width: 118px; height: 46px; label: "32"; active: root.entropy-bit-32; clicked => { root.entropy-toggle(5); } }
                KeyButton { width: 118px; height: 46px; label: "16"; active: root.entropy-bit-16; clicked => { root.entropy-toggle(4); } }
                KeyButton { width: 118px; height: 46px; label: "8"; active: root.entropy-bit-8; clicked => { root.entropy-toggle(3); } }
            }

            HorizontalLayout {
                height: 46px;
                padding-left: 3px;
                padding-right: 3px;
                spacing: 0px;

                KeyButton { width: 156px; height: 46px; label: "4"; active: root.entropy-bit-4; clicked => { root.entropy-toggle(2); } }
                KeyButton { width: 156px; height: 46px; label: "2"; active: root.entropy-bit-2; clicked => { root.entropy-toggle(1); } }
                KeyButton { width: 156px; height: 46px; label: "1"; active: root.entropy-bit-1; clicked => { root.entropy-toggle(0); } }
            }

            HorizontalLayout {
                height: 44px;
                padding-left: 1px;
                padding-right: 1px;
                spacing: 2px;

                KeyButton {
                    width: 156px;
                    height: 44px;
                    label: "Edit words";
                    clicked => { root.current-screen = 0; }
                }
                KeyButton {
                    width: 156px;
                    height: 44px;
                    label: "Reveal final word";
                    active: true;
                    clicked => { root.entropy-confirm(); }
                }
                KeyButton {
                    width: 156px;
                    height: 44px;
                    label: "Start over";
                    clicked => { root.mnemonic-reset(); root.current-screen = 0; }
                }
            }
        }

        BatteryStatusIcon {
            x: 454px;
            y: 2px;
            usb-present: root.usb-present;
            battery-present: root.battery-present;
            battery-percentage: root.battery-percentage;
            battery-charging: root.battery-charging;
            charge-complete: root.charge-complete;
        }
    }
}
