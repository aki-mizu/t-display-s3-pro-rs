import { BitcoinPalette, KeyButton } from "common.slint";

// A local-only BIP39 final-word helper. It never derives keys, signs, or
// persists a mnemonic; the Rust bridge retains only word-list indices.
export component AppWindow inherits Window {
    // Retained for the board wrapper's existing typed status API. These facts
    // are intentionally not rendered in the BIP39-only interface.
    in-out property <int> battery-percentage: 0;
    in-out property <bool> charging: false;
    in-out property <string> device-status: "";

    in-out property <int> current-screen: 0;
    in-out property <int> mnemonic-word-count: 0;
    in-out property <string> mnemonic-prefix: "";
    in-out property <string> mnemonic-entry: "";
    in-out property <string> mnemonic-message: "Enter word 1 of 11.";
    in-out property <bool> mnemonic-can-commit: false;
    in-out property <string> candidate-word: "";
    in-out property <int> candidate-index: 0;
    in-out property <string> entropy-bits-label: "0000000";
    in-out property <bool> entropy-bit-64: false;
    in-out property <bool> entropy-bit-32: false;
    in-out property <bool> entropy-bit-16: false;
    in-out property <bool> entropy-bit-8: false;
    in-out property <bool> entropy-bit-4: false;
    in-out property <bool> entropy-bit-2: false;
    in-out property <bool> entropy-bit-1: false;

    callback request-device-status();
    callback mnemonic-key(int);
    callback mnemonic-backspace();
    callback mnemonic-commit();
    callback mnemonic-reset();
    callback request-random-words();
    callback entropy-toggle(int);
    callback entropy-confirm();

    width: 480px;
    height: 222px;
    background: BitcoinPalette.page;

    Rectangle {
        width: 480px;
        height: 222px;
        background: BitcoinPalette.page;

        if root.current-screen == 0: VerticalLayout {
            padding-top: 3px;
            padding-bottom: 3px;
            padding-left: 0px;
            padding-right: 0px;
            // A 48 px square is the largest uniform letter key that fits ten
            // top-row keys across the 480 px display.
            spacing: 0px;

            Text {
                text: "BIP39 final word";
                color: BitcoinPalette.text;
                height: 15px;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: root.mnemonic-message;
                color: BitcoinPalette.muted;
                height: 10px;
                font-size: 9px;
                horizontal-alignment: center;
                overflow: elide;
            }

            Rectangle {
                height: 47px;
                background: BitcoinPalette.panel;
                border-color: BitcoinPalette.border;
                border-width: 1px;
                border-radius: 6px;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 4px;
                    padding-top: 1px;
                    padding-bottom: 1px;
                    spacing: 3px;

                    Text {
                        width: 70px;
                        text: root.mnemonic-prefix == "" ? "Input: —" : "Input: " + root.mnemonic-prefix;
                        color: BitcoinPalette.accent;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        width: 211px;
                        text: root.mnemonic-entry;
                        color: BitcoinPalette.text;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    KeyButton {
                        width: 104px;
                        height: 45px;
                        label: "Use word";
                        active: root.mnemonic-can-commit;
                        clicked => { root.mnemonic-commit(); }
                    }
                    KeyButton {
                        width: 70px;
                        height: 45px;
                        label: "Reset";
                        clicked => { root.mnemonic-reset(); }
                    }
                }
            }

            HorizontalLayout {
                height: 48px;
                padding-left: 0px;
                padding-right: 0px;
                spacing: 0px;

                KeyButton { width: 48px; height: 48px; label: "Q"; clicked => { root.mnemonic-key(16); } }
                KeyButton { width: 48px; height: 48px; label: "W"; clicked => { root.mnemonic-key(22); } }
                KeyButton { width: 48px; height: 48px; label: "E"; clicked => { root.mnemonic-key(4); } }
                KeyButton { width: 48px; height: 48px; label: "R"; clicked => { root.mnemonic-key(17); } }
                KeyButton { width: 48px; height: 48px; label: "T"; clicked => { root.mnemonic-key(19); } }
                KeyButton { width: 48px; height: 48px; label: "Y"; clicked => { root.mnemonic-key(24); } }
                KeyButton { width: 48px; height: 48px; label: "U"; clicked => { root.mnemonic-key(20); } }
                KeyButton { width: 48px; height: 48px; label: "I"; clicked => { root.mnemonic-key(8); } }
                KeyButton { width: 48px; height: 48px; label: "O"; clicked => { root.mnemonic-key(14); } }
                KeyButton { width: 48px; height: 48px; label: "P"; clicked => { root.mnemonic-key(15); } }
            }

            HorizontalLayout {
                height: 48px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 0px;

                KeyButton { width: 48px; height: 48px; label: "A"; clicked => { root.mnemonic-key(0); } }
                KeyButton { width: 48px; height: 48px; label: "S"; clicked => { root.mnemonic-key(18); } }
                KeyButton { width: 48px; height: 48px; label: "D"; clicked => { root.mnemonic-key(3); } }
                KeyButton { width: 48px; height: 48px; label: "F"; clicked => { root.mnemonic-key(5); } }
                KeyButton { width: 48px; height: 48px; label: "G"; clicked => { root.mnemonic-key(6); } }
                KeyButton { width: 48px; height: 48px; label: "H"; clicked => { root.mnemonic-key(7); } }
                KeyButton { width: 48px; height: 48px; label: "J"; clicked => { root.mnemonic-key(9); } }
                KeyButton { width: 48px; height: 48px; label: "K"; clicked => { root.mnemonic-key(10); } }
                KeyButton { width: 48px; height: 48px; label: "L"; clicked => { root.mnemonic-key(11); } }
            }

            HorizontalLayout {
                height: 48px;
                // Center the seven-letter bottom QWERTY cluster. The two
                // equally sized actions act like keyboard modifiers.
                padding-left: 0px;
                padding-right: 0px;
                spacing: 0px;

                KeyButton {
                    width: 72px;
                    height: 48px;
                    label: "Random 11";
                    clicked => { root.request-random-words(); }
                }
                KeyButton { width: 48px; height: 48px; label: "Z"; clicked => { root.mnemonic-key(25); } }
                KeyButton { width: 48px; height: 48px; label: "X"; clicked => { root.mnemonic-key(23); } }
                KeyButton { width: 48px; height: 48px; label: "C"; clicked => { root.mnemonic-key(2); } }
                KeyButton { width: 48px; height: 48px; label: "V"; clicked => { root.mnemonic-key(21); } }
                KeyButton { width: 48px; height: 48px; label: "B"; clicked => { root.mnemonic-key(1); } }
                KeyButton { width: 48px; height: 48px; label: "N"; clicked => { root.mnemonic-key(13); } }
                KeyButton { width: 48px; height: 48px; label: "M"; clicked => { root.mnemonic-key(12); } }
                KeyButton {
                    width: 72px;
                    height: 48px;
                    label: "Back";
                    clicked => { root.mnemonic-backspace(); }
                }
            }
        }

        if root.current-screen == 1: VerticalLayout {
            padding: 3px;
            spacing: 2px;

            Text {
                text: "Choose the seven entropy bits";
                color: BitcoinPalette.text;
                height: 15px;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: "Eleven words leave 128 valid final-word candidates.";
                color: BitcoinPalette.muted;
                height: 12px;
                font-size: 9px;
                horizontal-alignment: center;
                overflow: elide;
            }

            Rectangle {
                height: 36px;
                background: BitcoinPalette.panel;
                border-color: BitcoinPalette.border;
                border-width: 1px;
                border-radius: 6px;

                VerticalLayout {
                    padding: 3px;
                    spacing: 1px;

                    Text {
                        height: 12px;
                        text: "Selected bits: " + root.entropy-bits-label;
                        color: BitcoinPalette.accent;
                        font-size: 11px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.candidate-word == "" ? "Final word is not revealed." : "Candidate " + (root.candidate-index + 1) + " of 128: " + root.candidate-word;
                        color: BitcoinPalette.text;
                        font-size: 12px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            HorizontalLayout {
                height: 46px;
                padding-left: 1px;
                padding-right: 1px;
                spacing: 0px;

                KeyButton { width: 118px; height: 46px; label: "64"; active: root.entropy-bit-64; clicked => { root.entropy-toggle(6); } }
                KeyButton { width: 118px; height: 46px; label: "32"; active: root.entropy-bit-32; clicked => { root.entropy-toggle(5); } }
                KeyButton { width: 118px; height: 46px; label: "16"; active: root.entropy-bit-16; clicked => { root.entropy-toggle(4); } }
                KeyButton { width: 118px; height: 46px; label: "8"; active: root.entropy-bit-8; clicked => { root.entropy-toggle(3); } }
            }

            HorizontalLayout {
                height: 46px;
                padding-left: 3px;
                padding-right: 3px;
                spacing: 0px;

                KeyButton { width: 156px; height: 46px; label: "4"; active: root.entropy-bit-4; clicked => { root.entropy-toggle(2); } }
                KeyButton { width: 156px; height: 46px; label: "2"; active: root.entropy-bit-2; clicked => { root.entropy-toggle(1); } }
                KeyButton { width: 156px; height: 46px; label: "1"; active: root.entropy-bit-1; clicked => { root.entropy-toggle(0); } }
            }

            HorizontalLayout {
                height: 44px;
                padding-left: 1px;
                padding-right: 1px;
                spacing: 2px;

                KeyButton {
                    width: 156px;
                    height: 44px;
                    label: "Edit words";
                    clicked => { root.current-screen = 0; }
                }
                KeyButton {
                    width: 156px;
                    height: 44px;
                    label: "Reveal final word";
                    active: true;
                    clicked => { root.entropy-confirm(); }
                }
                KeyButton {
                    width: 156px;
                    height: 44px;
                    label: "Start over";
                    clicked => { root.mnemonic-reset(); root.current-screen = 0; }
                }
            }
        }
    }
}
